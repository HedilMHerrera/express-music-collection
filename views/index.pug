extends layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    .d-flex.flex-column
      h1.mb-0 Dashboard
      small.text-muted Bienvenidos a mi coleccion de musica personal.
    a.btn.btn-primary(href='/catalog/album/create')
      span.me-2 +
      | Agregar album

  .row.g-3.mb-4
    .col-6.col-md-3
      .card.shadow-sm.rounded.p-3.h-100
        .d-flex.align-items-center.justify-content-between
          .me-3
            small.text-muted Total Albums
            h3.mb-0 142
          .badge.bg-success.rounded-pill.text-white.small +4 esta semana
    .col-6.col-md-3
      .card.shadow-sm.rounded.p-3.h-100
        .d-flex.align-items-center.justify-content-between
          .me-3
            small.text-muted Total Artistas
            h3.mb-0 89
          .badge.bg-success.rounded-pill.text-white.small +1 esta semana
    .col-6.col-md-3
      .card.shadow-sm.rounded.p-3.h-100
        small.text-muted Generos
        h3.mb-0 12
    .col-6.col-md-3
      .card.shadow-sm.rounded.p-3.h-100
        small.text-muted Ejemplares
        h3.mb-0 142

  .row.g-3
    .col-lg-8
      .card.shadow-sm.h-100.rounded.d-flex.flex-column
        .card-body.flex-grow-1
          .d-flex.justify-content-between.align-items-center.mb-3
            h5.mb-0 Álbums por género
            select.form-select.form-select-sm(style='width:120px')
              option Este año
              option 2024
              option 2023
              option 2022

          - var fallbackCounts = '0,0,0,0,0,0,0,0'
          .chart-area.mt-3(data-counts=(genreCounts && genreCounts.length ? genreCounts.join(',') : fallbackCounts))
            .chart-visual.d-flex
              .y-axis.me-3
              .chart-main.flex-grow-1.position-relative
                .chart-grid
                .bars.d-flex.align-items-end.justify-content-between
                if (typeof genreCounts !== 'undefined' && genreCounts && genreCounts.length)
                  each val, i in genreCounts
                    .bar
                      .bar-fill
                else
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill
                  .bar
                    .bar-fill

          // chart area ends here; footer moved below card-body

        if (typeof genreCounts !== 'undefined' && genreCounts && genreCounts.length && genreNames && genreNames.length)
          .card-footer.bg-transparent.border-0.mt-2
            .chart-footer.d-flex.justify-content-between
              each val, i in genreCounts
                .chart-item.text-center
                  small.count= val + (val === 1 ? ' álbum' : ' álbumes')
                  br
                  small.name.text-muted= genreNames[i]
        else
          .card-footer.bg-transparent.border-0.mt-2
            .chart-footer.d-flex.justify-content-between
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Blues
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Country
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Electronic
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Jazz
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Opera
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Pop
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Rock
              .chart-item.text-center
                small.count 0 álbumes
                br
                small.name.text-muted Soul

    .col-lg-4
      .card.shadow-sm.h-100.rounded
        .card-body
          .d-flex.justify-content-between.align-items-center
            h5.mb-0 Adiciones recientes
            a.small(href='#') Ver todos →
          ul.list-unstyled.mt-3
            li.d-flex.align-items-center.mb-3
              .thumb.me-3(style='width:56px;height:56px;background:#ddd;border-radius:8px')
              .flex-grow-1
                strong.mb-0.d-block Dark Side of the Moon
                small.text-muted Pink Floyd · Rock
              .text-muted •••
            li.d-flex.align-items-center.mb-3
              .thumb.me-3(style='width:56px;height:56px;background:#ddd;border-radius:8px')
              .flex-grow-1
                strong.mb-0.d-block Random Access Memories
                small.text-muted Daft Punk · Electronic
              .text-muted •••
          .d-grid.mt-3
            button.btn.btn-outline-secondary Add New Item
