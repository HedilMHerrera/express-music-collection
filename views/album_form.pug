extends layout

block content
  h1= title
  form(method='POST')
    div
      label(for='title') Title:
      input#title(type='text', name='title', value=(album && album.title) ? album.title : '')
    div
      label(for='artist') Artist:
      select#artist(name='artist')
        each a in artists
          - var selected = (album && album.artist) ? (String(a._id) === String(album.artist)) : false;
          option(value=a._id selected=selected)= a.name
    div
      label(for='summary') Summary:
      textarea#summary(name='summary') #{(album && album.summary) ? album.summary : ''}
    div
      label Genres:
      if genres && genres.length
        ul
          each g in genres
            li
              - var checked = (g.checked) ? true : false
              input(type='checkbox', name='genre', value=g._id, checked=checked)
              |  #{g.name}
    div
      label(for='label') Label:
      input#label(type='text', name='label', value=(album && album.label) ? album.label : '')
    div
      button(type='submit') Submit
