extends layout

block content
  h1= title
  if genre
    p Are you sure you want to delete the genre: "#{genre.name}"?
    if genre_albums && genre_albums.length
      p This genre is used by the following albums and cannot be deleted:
      ul
        each b in genre_albums
          li
            a(href='/catalog/album/' + b._id)= b.title
      a(href='/catalog/genre/' + genre._id) Cancel
    else
      form(method='POST')
        input(type='hidden', name='genreid', value=genre._id)
        button(type='submit') Delete
      a(href='/catalog/genre/' + genre._id) Cancel
  else
    p Genre not found.
